# Akort backend — ortam değişkenleri (kopyalayıp .env yapın; opsiyoneldir).
# Tüm değerlerin makul dev varsayılanları vardır.

# API portu
PORT=8787

# JWT imzalama anahtarı — PRODUCTION'DA MUTLAKA güçlü, gizli bir değerle değiştirin.
JWT_SECRET=akort-dev-secret-change-me-in-production

# Seed sırasında oluşturulan demo kullanıcıların şifresi.
SEED_PASSWORD=akort2026

# SQLite veritabanı dosyasının yolu (Postgres'e taşırken burayı değiştirin).
# DATABASE_PATH=/data/akort.db
