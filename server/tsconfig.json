{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "paths": { "@/*": ["../src/*"] }
  },
  "include": ["src/**/*", "../src/lib/mockData.ts", "../src/lib/types.ts"]
}
